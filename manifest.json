{
  "manifest_version": 3,
  "name": "ChatGPT Theme Studio",
  "version": "0.1.1",
  "description": "A glassmorphism theme studio for ChatGPT with customizable wallpapers.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://images.unsplash.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT Theme Studio",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/theme.css"],
      "run_at": "document_idle"
    }
  ]
}